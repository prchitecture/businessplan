<script>
(function(){
'use strict';

// When the browser does not find locally installed fonts, the owner may choose their original .ttf files.
const fontInput=document.getElementById('brandFontFiles');
const fontStatus=document.getElementById('fontStatus');
document.querySelectorAll('.font-select-trigger').forEach(button=>button.addEventListener('click',()=>fontInput?.click()));
if(fontInput){fontInput.addEventListener('change',async()=>{
  const selected=Array.from(fontInput.files||[]);
  if(!selected.length)return;
  const specs=[
    {match:/(regular)/i,weight:'400'},
    {match:/(ultra.?bold)/i,weight:'800'},
    {match:/(ultra.?light|extra.?light|extlt)/i,weight:'300'}
  ];
  if(fontStatus)fontStatus.textContent='Đang nạp font từ các tệp bạn chọn…';
  let loaded=[];
  try{
    for(const spec of specs){
      const f=selected.find(file=>spec.match.test(file.name));
      if(!f)continue;
      const bytes=await f.arrayBuffer();
      const face=new FontFace('PR Telegraf User',bytes,{style:'normal',weight:spec.weight});
      await face.load();document.fonts.add(face);loaded.push(spec.weight);
    }
    if(loaded.length===0)throw Error('Không nhận diện được tên các tệp font DVN Telegraf.');
    document.documentElement.style.setProperty('--font','"PR Telegraf User", "PR Telegraf", Arial, sans-serif');
    document.documentElement.style.setProperty('--font-light','"PR Telegraf User", "PR Telegraf Light", Arial, sans-serif');
    if(fontStatus)fontStatus.textContent=loaded.length===3?'Đã nạp đủ Regular, UltraBold và ExtraLight.':'Đã nạp '+loaded.length+'/3 kiểu chữ. Chọn đủ ba tệp gốc để hoàn thiện.';
  }catch(error){if(fontStatus)fontStatus.textContent='Không nạp được font: '+error.message;}
});}

const menuButton=document.getElementById('menuButton');const nav=document.getElementById('sidebarNav');
if(menuButton&&nav){menuButton.addEventListener('click',()=>{const open=nav.classList.toggle('open');menuButton.setAttribute('aria-expanded',String(open));});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menuButton.setAttribute('aria-expanded','false');}));}
const topButton=document.getElementById('topButton'); if(topButton)topButton.addEventListener('click',()=>{location.hash='#top';window.scrollTo({top:0,behavior:'smooth'});});
const links=[...document.querySelectorAll('nav a[data-nav]')];const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+e.target.id));}})},{rootMargin:'-12% 0px -73% 0px',threshold:0});document.querySelectorAll('section.chapter').forEach(s=>obs.observe(s));
for(const t of document.querySelectorAll('.chapter-content table')){if(t.parentElement.classList.contains('table-scroll'))continue;const div=document.createElement('div');div.className='table-scroll';t.parentNode.insertBefore(div,t);div.appendChild(t);div.setAttribute('role','region');div.setAttribute('aria-label','Bảng dữ liệu có thể cuộn ngang');div.tabIndex=0;}
const ids=['Projects','ProjectPrice','Retainers','Monthly','Months','Direct','Overhead','Hours','HourValue'];
function num(id){return Math.max(0,Number(document.getElementById('calc'+id)?.value)||0)}
function format(n){return new Intl.NumberFormat('vi-VN',{maximumFractionDigits:1}).format(n)+' triệu'}
function calc(){const p=num('Projects'),pp=num('ProjectPrice'),r=num('Retainers'),m=num('Monthly'),mo=num('Months'),d=num('Direct')/100,o=num('Overhead'),h=num('Hours'),hr=num('HourValue');const revenue=p*pp+r*m*mo,cash=revenue*(1-d)-o,economic=cash-h*hr/1000;const vals=[['resultRevenue',revenue],['resultCash',cash],['resultEconomic',economic]];for(const [id,n] of vals){const el=document.getElementById(id);if(el){el.textContent=format(n);el.classList.toggle('negative',n<0);}}const hourly=document.getElementById('resultHourly');if(hourly)hourly.textContent=h>0?new Intl.NumberFormat('vi-VN',{maximumFractionDigits:0}).format(revenue*1000/h)+' nghìn đồng':'—';}
ids.forEach(id=>document.getElementById('calc'+id)?.addEventListener('input',calc));calc();
})();
</script>
