.site{display:grid;grid-template-columns:278px minmax(0,1fr);max-width:1850px;min-height:100vh;margin:0 auto}
.sidebar{position:sticky;top:0;height:100vh;overflow:auto;background:var(--brand);color:#fff;padding:28px 17px 24px;border-right:1px solid var(--brand);scrollbar-color:#acc6d9 var(--brand)}
.brand{display:flex;align-items:center;gap:11px;padding:2px 8px 23px;text-decoration:none;color:#fff;border-bottom:1px solid rgba(255,255,255,.28)}
