*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:24px}
body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--font);font-size:15.7px;font-weight:400;line-height:1.7;-webkit-font-smoothing:antialiased}
